pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/yogesh']], // Change to your branch if needed
                    userRemoteConfigs: [[
                        url: 'https://github.com/yogeshtambe7770/shopping.git' // Replace with your repo
                    ]]
                ])
            }
        }

        stage('Test') {
            steps {
                script {
                    // Run TestNG tests via Maven
                    sh 'mvn clean test -DsuiteXmlFile=testng.xml'
                }
            }
        }
    }
}

//Sample pipeline
